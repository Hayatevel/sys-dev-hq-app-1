# =========================
# OS-specific files
# =========================

# macOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
Desktop.ini

# =========================
# Java / Spring Boot backend
# =========================

# Maven build directory
target/

# Gradle build directory
build/

# Java class files
*.class

# Compiled JAR/WAR/EAR files
*.jar
*.war
*.ear

# Logs
*.log

# Temporary files
*.tmp

# Environment configuration (optional, if sensitive)
application.properties
application.yml
.env

# =========================
# Node.js / React (Vite) frontend
# =========================

# Node modules (dependencies)
node_modules/

# Vite build output
dist/

# Environment variables
.env
.env.local
.env.production
.env.development

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Docker-related files
# =========================

# Docker environment files (optional)
.env
docker-compose.override.yml

# Local volumes or runtime files
*.pid
*.seed
*.db

# =========================
# MySQL database files
# =========================

# MySQL data directory
db/data/
.devcontainer/db/

# =========================
# Uploaded user files
# =========================

# User uploaded files (profile images, etc.)
uploads/

# =========================
# Miscellaneous
# =========================

# Backup files
*~
*.bak
# Swap files
*.swp
*.swo

# Ignore everything except .gitignore itself
!.gitignore
